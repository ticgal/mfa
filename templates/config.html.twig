{% import 'components/form/fields_macros.html.twig' as fields %}

<form name="form" action="{{ form_url }}" method="post" data-track-changes="true">
    {{ fields.hiddenField('id', config.id) }}

    {% if warning %}
        <div class="alert alert-warning" role="alert">
            <i class="ti ti-alert-triangle me-1" aria-hidden="true"></i>
            {{ warning }}
            {{ __('Users covered by MFA will not be able to sign in until this is fixed.', 'mfa') }}
        </div>
    {% endif %}

    <div class="row">
        {{ fields.dropdownYesNo('local', config.local, __('GLPI Database Authentication', 'mfa'), {disabled: not canedit}) }}
        {{ fields.dropdownYesNo('mail', config.mail, __('Mail Server Authentication', 'mfa'), {disabled: not canedit}) }}
        {{ fields.dropdownYesNo('ldap', config.ldap, __('LDAP Directory Authentication', 'mfa'), {disabled: not canedit}) }}
        {{ fields.dropdownYesNo('external', config.external, __('External Authentication', 'mfa'), {disabled: not canedit}) }}
    </div>

    {% if canedit %}
        <div class="card-footer mx-n2 d-flex">
            <button type="submit" name="update" value="1" class="ms-auto btn btn-primary">
                <i class="ti ti-device-floppy" aria-hidden="true"></i>
                <span>{{ _x('button', 'Save') }}</span>
            </button>
        </div>
    {% endif %}
</form>

includes:
    - ../../vendor/glpi-project/phpstan-glpi/extension.neon
    - ../../vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - ../../vendor/thecodingmachine/phpstan-safe-rule/phpstan-safe-rule.neon

parameters:
    level: 5
    paths:
        - front
        - src
        - hook.php
        - setup.php
    scanDirectories:
        - ../../src
    bootstrapFiles:
        - ../../stubs/glpi_constants.php
        - ../../vendor/autoload.php
        - setup.php
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        -
            # The guard runs at kernel boot, where Html::redirect()'s RedirectException is not
            # handled and any other exception is logged as CRITICAL. See Guard::enforce().
            identifier: glpi.forbidExit
            path: src/Guard.php
